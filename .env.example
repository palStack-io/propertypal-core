# propertyPal Core - environment configuration
# Copy to .env. The README's quick start fills in the secrets for you.

# ===========================================
# Required secrets
# ===========================================
# Generate each with: openssl rand -hex 32
# propertyPal refuses to start with an empty, short or placeholder value,
# because anyone could forge sign-in tokens with a published secret.
SECRET_KEY=
JWT_SECRET_KEY=

# Database password. Set it before the first start and keep it: it is
# written into the database volume the first time Postgres starts.
POSTGRES_USER=propertypal
POSTGRES_PASSWORD=
POSTGRES_DB=propertypal

# ===========================================
# Optional settings
# ===========================================

# Port propertyPal is served on (http://localhost by default)
PORT=80

# Public URL, used in email links
# FRONTEND_URL=https://property.example.com

# The first person to sign up becomes the admin. After that, sign-up is closed
# unless you set this to true.
ALLOW_REGISTRATION=false

# Skip email verification (recommended for self-hosted installs without email)
SKIP_EMAIL_VERIFICATION=true

# Email (optional, for password reset)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=you@example.com

# Demo mode: creates three sample accounts on startup (for trying it out only)
DEMO_MODE=false
